# ==============================================================================
# SPBE KABUPATEN BEKASI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Supabase Client API (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Prisma ORM / PostgreSQL Connection Strings (Dashboard -> Project Settings -> Database)
# Transaction connection pooler (port 6543) - Digunakan untuk query aplikasi serverless
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - Digunakan untuk migrasi Prisma (prisma migrate / db push)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 3. Kunci Rahasia JWT Token
AUTH_SECRET="your-secure-secret-key-min-32-chars"
